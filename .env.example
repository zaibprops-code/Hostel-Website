# Riwaq Hostels — environment variables
# Copy to .env.local for local dev, or set these in the Vercel dashboard.
# See README → "On-site assistant & live seat availability".

# Password for the /admin/availability panel (required to sign in).
ADMIN_PASSWORD=

# Vercel KV (Upstash Redis) — required for admin edits to persist across
# deploys and serverless instances. Create via Vercel → Storage → KV; these
# two are injected automatically once the store is linked to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: a dedicated secret used to sign the admin session cookie.
# Falls back to ADMIN_PASSWORD if unset. Set a long random value in production.
ADMIN_SESSION_SECRET=
